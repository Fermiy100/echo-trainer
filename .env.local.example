# Скопируй в .env.local и заполни своими ключами (см. 02-ARCHITECTURE.md).
# Без ключей приложение продолжает работать — все вызовы уходят в офлайн-фоллбэк.

# platform.openai.com — платный, но быстрый и надёжный основной провайдер
# (см. 08-OPENAI-GUIDE.md). Если не задан, используется бесплатный NIM ниже.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# build.nvidia.com — бесплатно, 40 запросов/мин, резерв на случай без OpenAI-ключа
NVIDIA_NIM_API_KEY=
# Сверься с актуальным каталогом моделей на build.nvidia.com перед первым запуском
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_TEXT_MODEL=meta/llama-3.2-11b-vision-instruct

# platform.deepseek.com — платный резерв на случай лимита NIM, ~$3-4 из бюджета
DEEPSEEK_API_KEY=

# console.groq.com — только для демо-режима на защите
GROQ_API_KEY=

# Подставится автоматически после `vercel install neon`
DATABASE_URL=

# Подставится автоматически после `vercel install upstash`
KV_REST_API_URL=
KV_REST_API_TOKEN=
